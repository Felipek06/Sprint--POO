<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- O parent do Spring Boot traz o gerenciamento de versoes de todas as
         dependencias do ecossistema: por isso os <dependency> abaixo nao
         precisam declarar <version>. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.motiva</groupId>
    <artifactId>motiva-api</artifactId>
    <version>4.0.0</version>
    <name>MOTIVA API</name>
    <description>
        Sprint 4 - Migracao do sistema MOTIVA de JDBC puro (Sprint 3)
        para Spring Boot + Spring Data JPA + API REST.
    </description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <ojdbc.version>23.26.3.0.0</ojdbc.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             Starter WEB: embute o Tomcat e habilita @RestController,
             serializacao JSON (Jackson) e os codigos HTTP.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             Starter DATA JPA: traz o Hibernate e o Spring Data, que gera
             as implementacoes dos nossos Repository em tempo de execucao.
             E ele que substitui os 375 linhas de DAO da Sprint 3.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================================================
             Bean Validation (@Valid, @NotNull, @Positive) - item de bonus
             do enunciado. Validacoes de FORMATO ficam aqui; validacoes de
             REGRA DE NEGOCIO continuam no @Service.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             Driver Oracle via Maven (sem JAR manual em lib/, como era na
             Sprint 3). ojdbc17 = driver compilado para Java 17+.
             ============================================================ -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <version>${ojdbc.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             Testes: @SpringBootTest + MockMvc (bonus do enunciado).
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             H2 em memoria. Serve a dois propositos:

              1. a suite de testes roda sem depender do Oracle da FIAP
                 estar no ar;
              2. o perfil "demo" permite subir a API e demonstra-la em
                 qualquer maquina, sem banco instalado.

             O banco OFICIAL do projeto continua sendo o Oracle da FIAP: o
             perfil padrao (application.properties) aponta para la.
             ============================================================ -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Permite rodar a aplicacao com: mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
